{
  "name": "@project-forge/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:generate": "mikro-orm migration:create",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@mikro-orm/cli": "^7.1.15",
    "@mikro-orm/core": "^7.1.15",
    "@mikro-orm/decorators": "^7.1.15",
    "@mikro-orm/migrations": "^7.1.15",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.1.15",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
