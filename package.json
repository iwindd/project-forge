{
  "name": "project-forge",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @project-forge/api --filter @project-forge/admin dev",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:api": "pnpm --filter @project-forge/api dev",
    "dev:admin": "pnpm --filter @project-forge/admin dev",
    "build": "pnpm --recursive build",
    "check-types": "pnpm --recursive check-types",
    "format": "biome format --write apps",
    "format:check": "biome format apps",
    "lint": "biome lint apps",
    "check": "biome check apps && pnpm check-types",
    "test": "pnpm --filter @project-forge/api test",
    "db:migrate": "pnpm --filter @project-forge/api db:migrate",
    "db:generate": "pnpm --filter @project-forge/api db:generate",
    "db:verify": "pnpm --filter @project-forge/api db:verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12"
  }
}
