NODE_ENV=development
API_PORT=5050
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5051
DATABASE_URL=postgresql://project_forge:project_forge@localhost:55432/project_forge
SESSION_SECRET=replace-with-a-long-random-value
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
AUTH_SECRET=replace-with-a-long-random-value
AUTH_URL=http://localhost:5051
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5050/api/v1/auth/github/callback
GITHUB_SCOPES=read:user user:email
ADMIN_GITHUB_IDS=
HERMES_COMMAND=hermes
# Leave empty to let Project Forge manage a loopback Hermes backend on port 9119.
HERMES_GATEWAY_URL=
HERMES_GATEWAY_HOST=127.0.0.1
HERMES_GATEWAY_PORT=9119
HERMES_GATEWAY_PATH=/api/ws
# Optional server-only token for an already running Hermes backend.
# If empty, the managed loopback token is persisted under HERMES_HOME on this host.
HERMES_GATEWAY_TOKEN=
HERMES_AUTOSTART=true
HERMES_ISOLATED=true
HERMES_CONNECT_TIMEOUT_MS=10000
HERMES_START_TIMEOUT_MS=15000
SEED_ADMIN_GITHUB_ID=
SEED_ADMIN_GITHUB_LOGIN=
SEED_ADMIN_NAME=Project Forge Admin
SEED_ORGANIZATION_NAME=Project Forge
SEED_ORGANIZATION_SLUG=project-forge
NEXT_PUBLIC_API_URL=http://localhost:5050/api/v1
